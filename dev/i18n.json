{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "preferredVersions": {
    "php": "8.3",
    "wp": "latest"
  },
  "steps": [
    {
      "step": "wp-cli",
      "command": "wp i18n make-pot /wordpress/wp-content/plugins/jeytech-checkout-hours /wordpress/wp-content/plugins/jeytech-checkout-hours/languages/jeytech-checkout-hours.pot --slug=jeytech-checkout-hours --domain=jeytech-checkout-hours --exclude=dev,bin,node_modules,dist,.wordpress-org,vendor"
    },
    {
      "step": "wp-cli",
      "command": "wp i18n make-mo /wordpress/wp-content/plugins/jeytech-checkout-hours/languages"
    },
    {
      "step": "wp-cli",
      "command": "wp i18n make-php /wordpress/wp-content/plugins/jeytech-checkout-hours/languages"
    }
  ]
}
